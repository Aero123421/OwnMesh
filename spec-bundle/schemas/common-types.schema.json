{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownmesh.dev/schemas/common-types.schema.json",
  "title": "OwnMesh common time and pagination types",
  "description": "Shared timestamp, expiry, cursor, and pagination shapes.",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "expiry": {
      "type": "string",
      "format": "date-time",
      "description": "Absolute expiry instant (RFC3339)."
    },
    "cursor": {
      "type": "string",
      "pattern": "^cur_[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 128
    },
    "page_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": { "$ref": "#/$defs/cursor" },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 50
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": { "type": "array" },
        "next_cursor": { "$ref": "#/$defs/cursor" },
        "truncated": { "type": "boolean", "default": false }
      }
    }
  }
}
