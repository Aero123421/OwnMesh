{
  // OwnMesh control plane — user-owned Cloudflare deploy.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  // DO hibernation: https://developers.cloudflare.com/durable-objects/best-practices/websockets/
  // Intentionally no object-storage or relay bindings (spec §5.1 fail-closed).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ownmesh-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    // Privacy contract: persistence remains opt-in in the user's account.
    // See docs/deploy-cloudflare.md for a query-safe sampled configuration.
    "enabled": false
  },
  "vars": {
    // OAUTH_ISSUER is intentionally omitted: the Worker uses its request origin.
    // Set it only when deploying behind a stable custom domain.
    // Security-sensitive development escape hatch. Keep false in deployments.
    "OWNMESH_DEV_AUTH_BYPASS": "false",
    // Advertise DCR so ChatGPT can connect from only the MCP URL. Exact ChatGPT
    // public callbacks are stateless; all other registrations require a tenant token.
    "ALLOW_DYNAMIC_CLIENT_REGISTRATION": "true",
    // Optional comma-separated WebSocket origins in addition to OAUTH_ISSUER.
    "OWNMESH_ALLOWED_ORIGINS": "",
    // Per-tenant durable MCP operation row cap. Invalid values fall back to 20000.
    "MCP_OPS_MAX_PER_TENANT": "20000",
    // Audit metadata is retained for 30 days and capped per tenant.
    "AUDIT_RETENTION_DAYS": "30",
    "AUDIT_MAX_PER_TENANT": "50000",
    // Synchronous command timeout clamp in milliseconds. Invalid values fall back to 300000.
    "MCP_MAX_TIMEOUT_MS": "300000"
    // SESSION_SECRET and the one-time passkey bootstrap hash OWNER_TOKEN_HASH
    // must be provided via Wrangler secrets.
    // AUTH_PROVIDER is optional when built-in single-owner auth is configured.
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ownmesh",
      // Wrangler / Deploy to Cloudflare resolves or provisions this by name.
      // Never commit an operator's account-specific database_id.
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "120260811",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "120260812",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "AUTH_IP_RATE_LIMITER",
      "namespace_id": "120260813",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "MCP_IP_RATE_LIMITER",
      "namespace_id": "120260814",
      "simple": { "limit": 1200, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_ROOM",
        "class_name": "DeviceRoom"
      },
      {
        "name": "TRANSFER_ROOM",
        "class_name": "TransferRoom"
      },
      {
        // Issue #224 plan F (P2): tenant-sharded durable operation authority.
        "name": "OPERATION_ROOM",
        "class_name": "OperationRoom"
      }
    ]
  },
  "migrations": [
    {
      // SQLite-backed DO for hibernation-friendly device rooms.
      // https://developers.cloudflare.com/durable-objects/best-practices/websockets/
      "tag": "v1",
      "new_sqlite_classes": ["DeviceRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TransferRoom"]
    },
    {
      // Tenant-sharded operation log storage (Issue #224 plan F P2).
      "tag": "v3",
      "new_sqlite_classes": ["OperationRoom"]
    }
  ],
  // Issue #224 (P1/P4): scheduled retention drain so request traffic stops
  // inheriting TTL catch-up bursts. Request-path leases stay as fallback.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
