{
  // OwnMesh control plane — user-owned Cloudflare deploy.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  // DO hibernation: https://developers.cloudflare.com/durable-objects/best-practices/websockets/
  // Intentionally no object-storage or relay bindings (spec §5.1 fail-closed).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ownmesh-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // OAUTH_ISSUER is intentionally omitted: the Worker uses its request origin.
    // Set it only when deploying behind a stable custom domain.
    // Security-sensitive development escape hatch. Keep false in deployments.
    "OWNMESH_DEV_AUTH_BYPASS": "false",
    // Advertise DCR so ChatGPT can connect from only the MCP URL. Exact ChatGPT
    // public callbacks are stateless; all other registrations require a tenant token.
    "ALLOW_DYNAMIC_CLIENT_REGISTRATION": "true",
    // Optional comma-separated WebSocket origins in addition to OAUTH_ISSUER.
    "OWNMESH_ALLOWED_ORIGINS": ""
    // SESSION_SECRET and the one-time passkey bootstrap hash OWNER_TOKEN_HASH
    // must be provided via Wrangler secrets.
    // AUTH_PROVIDER is optional when built-in single-owner auth is configured.
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ownmesh",
      // Wrangler / Deploy to Cloudflare resolves or provisions this by name.
      // Never commit an operator's account-specific database_id.
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "120260811",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "120260812",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_ROOM",
        "class_name": "DeviceRoom"
      },
      {
        "name": "TRANSFER_ROOM",
        "class_name": "TransferRoom"
      }
    ]
  },
  "migrations": [
    {
      // SQLite-backed DO for hibernation-friendly device rooms.
      // https://developers.cloudflare.com/durable-objects/best-practices/websockets/
      "tag": "v1",
      "new_sqlite_classes": ["DeviceRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TransferRoom"]
    }
  ]
}
