{
  // OwnMesh control plane — user-owned Cloudflare deploy.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  // DO hibernation: https://developers.cloudflare.com/durable-objects/best-practices/websockets/
  // Intentionally no object-storage or relay bindings (spec §5.1 fail-closed).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ownmesh-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Set to your Worker URL after first deploy if it differs from request origin.
    "OAUTH_ISSUER": "https://ownmesh-control-plane.namaste114.workers.dev",
    // Security-sensitive development escape hatch. Keep false in deployments.
    "OWNMESH_DEV_AUTH_BYPASS": "false",
    // Dynamic registration is opt-in; provision static clients unless explicitly needed.
    "ALLOW_DYNAMIC_CLIENT_REGISTRATION": "false",
    // Optional comma-separated WebSocket origins in addition to OAUTH_ISSUER.
    "OWNMESH_ALLOWED_ORIGINS": ""
    // SESSION_SECRET must be provided via wrangler secret / .dev.vars (never commit real values).
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ownmesh",
      // Replace via `wrangler d1 create ownmesh` (Deploy to Cloudflare button fills this).
      "database_id": "4198b4d0-c043-4dda-b641-16578d84c091",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_ROOM",
        "class_name": "DeviceRoom"
      },
      {
        "name": "TRANSFER_ROOM",
        "class_name": "TransferRoom"
      }
    ]
  },
  "migrations": [
    {
      // SQLite-backed DO for hibernation-friendly device rooms.
      // https://developers.cloudflare.com/durable-objects/best-practices/websockets/
      "tag": "v1",
      "new_sqlite_classes": ["DeviceRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TransferRoom"]
    }
  ]
}
