{
  "name": "@ownmesh/schema",
  "private": true,
  "version": "1.2.10",
  "description": "OwnMesh TypeScript domain types, protocol envelope helpers, and fixture validation",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node ../../scripts/lint-ts.mjs src",
